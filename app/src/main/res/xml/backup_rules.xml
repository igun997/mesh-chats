<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy full-backup rules (Android 11 and below, android:fullBackupContent).
  Backup is disabled outright via android:allowBackup="false", so these rules are
  never consulted on any supported OS. They are kept as defense-in-depth: if a
  future change re-enables backup, the sensitive stores are already excluded.

  Excluded: the encrypted Room database (and its plaintext-migration side files),
  the wrapped database key + any other files under noBackupFilesDir is already
  excluded by the platform, and all shared preferences / DataStore. Capturing any
  of these off-device could expose the encrypted database to offline decryption.
-->
<full-backup-content>
    <!-- Encrypted database and its WAL/SHM + migration temp/backup/marker siblings. -->
    <exclude domain="database" path="mesh-chats.db" />
    <exclude domain="database" path="mesh-chats.db-wal" />
    <exclude domain="database" path="mesh-chats.db-shm" />
    <exclude domain="database" path="mesh-chats.db.enc-tmp" />
    <exclude domain="database" path="mesh-chats.db.pt-bak" />
    <exclude domain="database" path="mesh-chats.db-wal.pt-bak" />
    <exclude domain="database" path="mesh-chats.db-shm.pt-bak" />
    <exclude domain="database" path="mesh-chats.db.migration" />
    <!-- All app files (covers any wrapped-secret material written to filesDir). -->
    <exclude domain="file" path="." />
    <!-- Preferences / DataStore. -->
    <exclude domain="sharedpref" path="." />
</full-backup-content>
